  {
    "name": "$ref with a description sibling is inlined; the sibling description wins",
    "target": "gemini",
    "input": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/User",
          "description": "Repo owner"
        }
      },
      "$defs": {
        "User": {
          "type": "object",
          "properties": {
            "login": {
              "type": "string"
            }
          },
          "required": [
            "login"
          ],
          "description": "A user"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "owner": {
          "description": "Repo owner",
          "type": "object",
          "properties": {
            "login": {
              "type": "string"
            }
          },
          "required": [
            "login"
          ]
        }
      }
    },
    "changes": [
      "gemini.ref_inlined@/properties/owner",
      "gemini.unsupported_keyword@/$defs"
    ],
    "lossy": [],
    "issues": []
  },
  {
    "name": "recursive $ref cannot be inlined: unrepairable (google-genai Schema has no $ref/$defs)",
    "target": "gemini",
    "input": {
      "type": "object",
      "properties": {
        "tree": {
          "$ref": "#/$defs/Node"
        }
      },
      "$defs": {
        "Node": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "tree": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              }
            }
          }
        }
      },
      "$defs": {
        "Node": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Node"
              }
            }
          }
        }
      }
    },
    "changes": [
      "gemini.ref_inlined@/properties/tree"
    ],
    "lossy": [],
    "issues": [
      "gemini.recursive_ref@/properties/tree/properties/children/items"
    ]
  },
