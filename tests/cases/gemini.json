[
  {
    "name": "zod / MCP TypeScript SDK output: $schema, additionalProperties, exclusiveMinimum",
    "target": "gemini",
    "input": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File path"
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "output": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File path"
        },
        "limit": {
          "type": "integer",
          "description": "{exclusiveMinimum: 0}"
        }
      },
      "required": [
        "path"
      ]
    },
    "changes": [
      "gemini.unsupported_keyword@/properties/limit/exclusiveMinimum",
      "gemini.additional_properties@/additionalProperties",
      "gemini.unsupported_keyword@/$schema"
    ],
    "lossy": [
      "gemini.unsupported_keyword@/properties/limit/exclusiveMinimum",
      "gemini.additional_properties@/additionalProperties"
    ],
    "issues": []
  },
  {
    "name": "pydantic Optional[int] = None: anyOf with null becomes nullable",
    "target": "gemini",
    "input": {
      "type": "object",
      "properties": {
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        }
      },
      "required": []
    },
    "output": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "nullable": true,
          "default": null,
          "title": "N"
        }
      },
      "required": []
    },
    "changes": [
      "gemini.null_branch@/properties/n/anyOf"
    ],
    "lossy": [],
    "issues": []
  },
  {
    "name": "type array with several types and an enum is split into anyOf branches",
    "target": "gemini",
    "input": {
      "type": "object",
      "properties": {
        "v": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "enum": [
            "a",
            1,
            null
          ],
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "v": {
          "nullable": true,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "enum": [
                "a"
              ]
            },
            {
              "type": "number",
              "enum": [
                "1"
              ]
            }
          ]
        }
      }
    },
    "changes": [
      "gemini.type_array@/properties/v/type",
      "gemini.enum_stringified@/properties/v/anyOf/1/enum"
    ],
    "lossy": [
      "gemini.enum_stringified@/properties/v/anyOf/1/enum"
    ],
    "issues": []
  },
