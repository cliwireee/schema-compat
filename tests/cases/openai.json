  {
    "name": "strict: optional properties become required and nullable; additionalProperties added",
    "target": "openai-strict",
    "input": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "e": {
          "enum": [
            "a",
            "b"
          ]
        },
        "r": {
          "$ref": "#/$defs/X"
        },
        "already": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "q"
      ],
      "$defs": {
        "X": {
          "type": "object",
          "properties": {
            "a": {
