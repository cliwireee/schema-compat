          "required": [
            "a"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string"
        },
        "n": {
          "type": [
            "integer",
            "null"
          ]
        },
        "e": {
          "enum": [
            "a",
            "b",
            null
          ]
        },
        "r": {
          "anyOf": [
            {
              "$ref": "#/$defs/X"
            },
            {
              "type": "null"
            }
          ]
        },
        "already": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "q",
        "n",
        "e",
        "r",
        "already"
      ],
      "additionalProperties": false,
      "$defs": {
        "X": {
          "type": "object",
          "properties": {
            "a": {
              "type": "string"
            }
          },
          "required": [
            "a"
          ],
          "additionalProperties": false
        }
      }
    },
    "changes": [
      "openai_strict.optional_property@/properties/n",
      "openai_strict.optional_property@/properties/e",
      "openai_strict.optional_property@/properties/r",
      "openai_strict.optional_property@/properties/already",
      "openai_strict.additional_properties@",
      "openai_strict.additional_properties@/$defs/X"
    ],
    "lossy": [
